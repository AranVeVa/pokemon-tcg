# Variables de Entorno para Vercel (Frontend en Producción)
# Coloca la URL pública que Render te entregue para tu Web Service backend
VITE_API_URL=https://pokemon-tcg-backend.onrender.com

# ID de Medición de Google Analytics 4 (obténlo en analytics.google.com -> Flujos de datos web)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# (Opcional) Clave publicable de Stripe en modo prueba (pk_test_...). También se puede definir solo en Render como STRIPE_PUBLISHABLE_KEY
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
